# Copie para .env.local e preencha. Nunca commite segredos.
ANTHROPIC_API_KEY=
# Opcional: modelo usado pelo agente (formato provider/model)
COPILOT_MODEL=anthropic/claude-sonnet-4-6

# --- Login (NextAuth) ---
# URL pública do app e segredo para assinar a sessão (gere com: openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Configure ao menos um provedor. Callback: <NEXTAUTH_URL>/api/auth/callback/<github|google>
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Só para desenvolvimento/testes: login SEM senha. Nunca use em produção.
AUTH_DEV_LOGIN=false

# Opcional: servidor MCP (Streamable HTTP) cujas tools entram no agente
MCP_SERVER_URL=
MCP_SERVER_TOKEN=
